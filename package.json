{
  "name": "aila-ngo-v2",
  "version": "4.5.3",
  "description": "An NGO in consultative status with the United Nations Economic & Social Council (ECOSOC)",
  "author": "American Indian Law Alliance",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "clean": "rimraf dist src/_includes/css src/_includes/scripts",
    "clean:og": "rimraf src/assets/og-images",
    "favicons": "node ./src/_config/setup/generate-favicons.js",
    "colors": "node ./src/_config/setup/create-colors.js",
    "screenshots": "node ./src/_config/setup/generate-screenshots.js",
    "dev": "npm run dev:11ty",
    "dev:11ty": "cross-env ELEVENTY_ENV=development OPENGRAPHGEN=false eleventy --serve",
    "build:11ty": "cross-env ELEVENTY_ENV=production OPENGRAPHGEN=false eleventy",
    "start": "npm run serve",
    "serve": "sirv dist --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "npm run clean && npm run build:11ty && pagefind --site dist",
    "pagefind": "pagefind --site dist",
    "perf": "cross-env ELEVENTY_ENV=production OPENGRAPHGEN=false DEBUG=Eleventy:*Benchmark* eleventy",
    "perf:file": "npm run perf > perf-output.txt 2>&1",
    "docs:dedup": "node ./scripts/dedup-documents.mjs",
    "docs:check": "node ./scripts/dedup-documents.mjs --check"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/adamdjbrett/aila-ngo-v2.git"
  },
  "dependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10",
    "@11ty/eleventy-fetch": "5.1.3",
    "@11ty/eleventy-img": "7.0.0",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@11ty/eleventy-plugin-webc": "0.12.0-beta.7",
    "@11ty/font-awesome": "1.0.1",
    "@11ty/is-land": "5.0.1",
    "@zachleat/pagefind-search": "^1.0.3",
    "sirv-cli": "3.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@toycode/markdown-it-class": "^1.2.4",
    "@xmit.co/xmit": "0.5.2-0",
    "autoprefixer": "^10.4.24",
    "colorjs.io": "^0.6.1",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "esbuild": "0.28.1",
    "fast-glob": "^3.3.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.1",
    "lodash.chunk": "^4.2.0",
    "markdown-it": "^14.2.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-prism": "^3.0.1",
    "node-addon-api": "8.7.0",
    "node-gyp": "12.3.0",
    "pagefind": "1.5.2",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-js": "^5.1.0",
    "prettier-plugin-jinja-template": "^2.1.0",
    "remove-markdown": "^0.6.3",
    "rimraf": "^6.1.3",
    "sanitize-html": "^2.17.0",
    "sharp": "0.35.3",
    "sharp-ico": "^0.1.5",
    "slugify": "^1.6.6",
    "svgo": "^4.0.0"
  },
  "packageManager": "npm@11.14.0",
  "overrides": {
    "undici": "~7.28.0"
  }
}
