---
layout: tags
permalink: /tags/index.html
eleventyComputed:
  title: '{{ meta.blog.tagPlural }}'
---

<div class="taglist | mt-s-m cluster">
  {% for tag in collections.tagList %}
    {# Route is /tag/<slug>/ (singular) — see the tagPages collection. #}
    <a href="/tag/{{ tag | slugify }}/" class="button"> {{ tag }} </a>
  {% endfor %}
</div>

<custom-masonry layout="50-50">
  {% set itemlist = collections.posts %}
  {% for item in itemlist %}

		{# Lean card: this page renders every post, so no images or tag chips. #}
		{% set showImage = false %}
		{% set showTags = false %}
		{% include "partials/card-blog.njk" %}
  {% endfor %}
</custom-masonry>
