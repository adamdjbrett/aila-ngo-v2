{#
  Post card. Covers both the rich listing card (blog, tag/category listings,
  discovery) and the lean variant used by /tags/, which previously lived in a
  near-identical card-tag.njk.

  Callers may set:
    showImage   default true  — cover image
    showTags    default true  — tag chips
    showContent default true  — description/excerpt paragraph
#}
{% set headingLevel = headingLevel | default("h2") %}
{% set definedDate = definedDate | default(item.date) %}
{% set showTags = showTags | default(true) %}
{% set showImage = showImage | default(true) %}
{% set showContent = showContent | default(true) %}
{% set cardContent = item.data.description or item.data.page.excerpt %}

<custom-card clickable {% if showImage %}img-square{% endif %}>
  {% if showImage and item.data.coverImage %}
  {%
        imageKeys {
          "src": item.data.coverImage,
          "alt": item.data.alt or "",
          "credit": credit,
          "loading": "lazy",
          "slot": "image"
        }
  %}
  {% endif %}
  <{{ headingLevel }} slot="headline" class="text-step-2">
    <a href="{{ item.url | url }}">{{ item.data.title }}</a>
  </{{ headingLevel }}>
  <span slot="date">{%- if item.data.draft -%}<span class="button" data-small-button data-button-variant='tertiary'>draft</span>{%- endif %} {% include "partials/date.njk" %}</span>
  {% if showTags and item.data.tags.length > 1 %}
    <div slot="tag" webc:nokeep>
      {% for tag in item.data.tags %}
        {% if tag != "posts" %}
          <span class="button" data-small-button>{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  {# Only emit the paragraph when there is something to put in it — the lean
     variant used to ship an empty <p> on every card. #}
  {% if showContent and cardContent %}
    <p slot="content">{{ cardContent | safe }}</p>
  {% endif %}
</custom-card>

{% css "local" %}
  {% include "css/custom-card.css" %}
{% endcss %}
