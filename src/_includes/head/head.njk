{#
  The whole <head>, in the order Harry Roberts recommends:
  charset/viewport and <title> come from the layout, then the render-blocking
  theme script, structured data, CSS, preloads, deferred JS, and finally the
  meta/link block.

  This was six separate partials (js-inline, schema, css-inline, preloads,
  js-defer, meta-info). They were always included together in a fixed order by
  exactly one layout, so the split bought indirection rather than reuse.
#}
{% set metaDescription %}
  {%- if discover.description -%}
    {{- discover.description -}}
  {%- elif description -%}
    {{- description -}}
 {%- elif page.excerpt -%}
    {{- page.excerpt -}}
  {%- else -%}
    {{- meta.siteDescription -}}
  {%- endif -%}
{% endset %}
{% set isPost = layout == 'post' %}

{# --- Synchronous JS ------------------------------------------------------
  Deliberately inline and non-deferred: the theme toggle has to run before
  first paint or the page flashes the wrong colour scheme. #}
<script>{% getBundle "js", "inline" %}</script>

{%- js "inline" %}
{% include "scripts/is-land.js" %}
{% include "scripts/theme-toggle.js" %}
{% endjs %}

{# --- Structured data ----------------------------------------------------- #}
{% include "schemas/WebSite.njk" %}
{% if schema %}
  {%- include "schemas/" + schema + ".njk" -%}
{% endif %}

{# --- CSS -----------------------------------------------------------------
  Linked, not inlined, so one content-hashed file is cached across all pages
  instead of ~31 KB being duplicated into every document. The per-page "local"
  bundle stays inline because it genuinely differs per page. #}
<link rel="stylesheet" href="{% getBundleFileUrl "css", "global" %}">
<style>{% getBundle "css", "local" %}</style>

{% css "global" %}{% include "css/global.css" %}{% endcss %}

{# --- Preloads ------------------------------------------------------------ #}
<link
  rel="preload"
  href="/assets/fonts/redhat/red-hat-display-v7-latin-900.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<link
  rel="preload"
  href="/assets/fonts/atkinson/atkinson-hyperlegible-regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- preloads in page data -->
{%- if preloads -%}
  <!-- prettier-ignore -->
  <link rel="preload"
			href="{{ preloads.href }}"
			as="{{ preloads.as }}"
			{% if preloads.type %}type={{ preloads.type }}{% endif %}{% if preloads.imagesrcset %}imagesrcset="{{ preloads.imagesrcset }}"{% endif %}
			{% if preloads.crossorigin %}crossorigin{% endif %} />
{% endif %}

{# --- Deferred JS --------------------------------------------------------- #}
<script src="{% getBundleFileUrl "js", "defer" %}" type="module"></script>

{# --- Meta, icons, Open Graph, citation metadata -------------------------- #}
<meta name="description" content="{{ metaDescription }}" />
<meta name="theme-color" content="{{ meta.themeDark }}" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="{{ meta.themeLight }}" media="(prefers-color-scheme: light)" />
<!-- Search Engines -->
<meta name="robots" content="index,follow" />
<meta name="googlebot" content="index,follow" />
<!-- Made with Eleventy! -->
<meta name="generator" content="{{ eleventy.generator }}" />
<!-- Disable automatic detection and formatting of possible phone numbers -->
<meta name="format-detection" content="telephone=no" />
<!-- supports both dark and light color schemes, page author prefers light as default. -->
<meta name="color-scheme" content="light dark" />
<!-- Helps prevent duplicate content issues -->
<link rel="canonical" href="{{ meta.url }}{{ page.url }}" />
<!-- Links to information about the author(s) of the document -->
<link rel="author" href="/humans.txt" />
{% if isPost %}
<link rel="cite-as" href="{{ meta.url }}{{ page.url }}" />
<link rel="type" href="https://schema.org/BlogPosting" />
<link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="{{ page.url }}metadata.json" />
{% else %}
<link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="/metadata.json" />
{% endif %}

{% if organization.platforms.mastodon %}
  <!-- Mastodon verified site -->
  <link rel="me" href="{{ organization.platforms.mastodon }}" />
{% endif %}

{% if meta.author.fediverse %}
  <!-- fediverse creator tag -->
  <meta name="fediverse:creator" content="{{ meta.author.fediverse }}" />
{% endif %}

<!-- Open Graph meta  -->
<meta property="og:url" content="{{ meta.url }}{{ page.url }}" />
<meta property="og:type" content="website" />
<meta
  property="og:title"
  content="{%- if discover.title -%}
    {{- discover.title -}}
  {%- elif title -%}
    {{- title -}}
  {%- else -%}
    {{- meta.siteName -}}
  {%- endif -%}"
/>
<meta
  property="og:image"
  content="{%- if meta.OPENGRAPHGEN and layout == 'post' -%}
    {{- meta.url -}}/assets/og-images/{{ title | slugify }}-preview.jpeg
  {%- else -%}
    {{- meta.url -}}{{- meta.opengraph_default -}}
  {%- endif -%}"
/>
<meta
  property="og:image:alt"
  content="{%- if layout == 'post' -%}
    {{- title -}}
  {%- else -%}
    {{- meta.opengraph_default_alt -}}
  {%- endif -%}"
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:description" content="{{ metaDescription }}" />
<meta property="og:site_name" content="{{ meta.siteName }}" />
<meta property="og:locale" content="{{ meta.locale }}" />
<meta property="article:author" content="{{ meta.author.name }}" />

<!-- Twitter specific head data was removed in v2 -->

<!-- RSS Autodiscovery. Loops over meta.blog.feedLinks -->
{% for feedLink in meta.blog.feedLinks %}
  <link
    rel="alternate"
    type="{{ feedLink.type }}"
    title="{{ feedLink.title }}: {{ meta.siteName }}"
    href="{{ feedLink.url }}"
  />
{% endfor %}

<!-- Favicon: https://evilmartians.com/chronicles/how-to-favicon-in-2021-six-files-that-fit-most-needs -->
<link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any" />
<link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml" />
<link rel="apple-touch-icon" sizes="180x180" href="{{ '/apple-touch-icon.png' | url }}" />
<link rel="manifest" href="{{ '/site.webmanifest' | url }}" />

{# Zotero / Highwire / PRISM — makes posts harvestable as Blog Post type #}
{% if isPost %}
<meta property="zotero:itemType" content="blogPost" />
<meta property="dc:title" content="{{ title | escape }}" />
<meta property="dc:creator" content="{{ meta.author.name | escape }}" />
{% if date %}<meta property="dc:date" content="{{ date | formatDate('YYYY-MM-DD') }}" />{% endif %}
<meta property="dc:language" content="{{ meta.lang }}" />
<meta property="dc:identifier" content="{{ meta.url }}{{ page.url }}" />
<meta name="citation_author" content="{{ meta.author.name | escape }}" />
{% if date %}<meta name="citation_publication_date" content="{{ date | formatDate('YYYY-MM-DD') }}" />{% endif %}
<meta name="citation_public_url" content="{{ meta.url }}{{ page.url }}" />
<meta name="citation_language" content="{{ meta.lang }}" />
{% if doi %}<meta name="citation_doi" content="{{ doi | escape }}" />{% endif %}
<meta name="prism.genre" content="blogentry" />
<meta name="prism.publicationName" content="AILA" />
{% endif %}
