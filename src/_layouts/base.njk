<!doctype html>
<html lang="{{ meta.lang }}" prefix="zotero: http://www.zotero.org/namespaces/export#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
      {%- if title -%}
        {{- title -}}
      {%- else -%}
        {{- meta.siteName -}}
      {%- endif -%}
    </title>

    {% include "head/head.njk" %}
  </head>

  <body class="{{ layout }}">
    {% set indicateActiveHome %}
      {% if page.url == "/" %}
        aria-current=page
      {% endif %}
    {% endset %}
    {% include "partials/header.njk" %}

    <main id="main" class="flow">{{ content | safe }}</main>

    {% include "partials/footer.njk" %}

    {# Icon sprite. Must sit inside <body> — it renders <svg><symbol> markup,
       which is invalid between </body> and </html> where it used to live. #}
    <div hidden>{% getBundle "fontawesome" %}</div>
  </body>
</html>
